# Laravel generated files
/bootstrap/cache/*.php
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
!/storage/logs/.gitkeep
!/storage/framework/cache/data/.gitkeep
!/storage/framework/sessions/.gitkeep
!/storage/framework/testing/.gitkeep
!/storage/framework/views/.gitkeep

# User-uploaded content (not source code)
/public/products_pictures/*
!/public/products_pictures/.gitkeep
/public/user_pictures/*
!/public/user_pictures/.gitkeep
/public/upload/*
!/public/upload/.gitkeep

# SQLite test databases
*.sqlite
*.sqlite-shm
*.sqlite-wal
/tmp/*.sqlite
