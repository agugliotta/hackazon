{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "agugliotta/hackazon",
    "type": "project",
    "description": "Intentionally vulnerable e-commerce app for security training — PHP 8.4 / Laravel 13 migration of Rapid7 Hackazon. Includes SQLi, XSS, CSRF, IDOR, XXE, RFI, OS Command Injection.",
    "keywords": [
        "hackazon", "vulnerable-by-design", "security-training",
        "penetration-testing", "ctf", "dvwa", "webgoat",
        "sql-injection", "xss", "csrf", "idor", "xxe",
        "laravel", "php", "docker", "offensive-security"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "apache/log4php": "^2.3",
        "doctrine/annotations": "^2.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "VulnModule\\": "app/VulnModule/",
            "PDOV\\": "app/PDOV/",
            "GWTModule\\": "app/GWTModule/",
            "AmfphpModule\\": "app/AmfphpModule/"
        },
        "classmap": [
            "app/GWTModule/gwtphp-maps",
            "app/AmfphpModule/Plugins/Pixifier",
            "app/AmfphpModule/Plugins/AmfphpJsonEx",
            "app/PDOV",
            "vendor/hackazon/amfphp/Amfphp",
            "vendor/gwtphp/gwtphp/src"
        ],
        "files": [
            "vendor/hackazon/amfphp/Amfphp/ClassLoader.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
